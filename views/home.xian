{{> head }}
<body class="bg-gray-50 text-gray-800">
  <main class="mx-auto min-h-[70vh] w-full px-2 pt-12">
    <h1 class="mb-8 text-center text-2xl font-bold">Welcome to XianFire 🔥</h1>

    {{#if message}}
      <p class="mb-4 text-center text-green-700">{{message}}</p>
    {{/if}}

    <form class="mx-auto mb-8 flex max-w-5xl flex-wrap items-center justify-center gap-2" action="{{#if editingProduct}}/products/{{editingProduct.id}}/edit{{else}}/products/create{{/if}}" method="POST">
      <input class="w-36 rounded border border-gray-200 bg-white px-2 py-1 text-sm" name="productname" placeholder="ProductName" value="{{editingProduct.productname}}" required>
      <input class="w-36 rounded border border-gray-200 bg-white px-2 py-1 text-sm" name="description" placeholder="Description" value="{{editingProduct.description}}" required>
      <input class="w-24 rounded border border-gray-200 bg-white px-2 py-1 text-sm" name="category" placeholder="Category" value="{{editingProduct.category}}" required>
      <input class="w-24 rounded border border-gray-200 bg-white px-2 py-1 text-sm" type="number" name="price" min="0" step="0.01" placeholder="Price" value="{{editingProduct.price}}" required>
      <input class="w-24 rounded border border-gray-200 bg-white px-2 py-1 text-sm" type="number" name="quantity" min="0" step="1" placeholder="Quantity" value="{{editingProduct.quantity}}" required>
      <button class="px-2 py-1 text-sm text-blue-700 hover:underline" type="submit">{{#if editingProduct}}Save{{else}}Submit{{/if}}</button>
      {{#if editingProduct}}<a class="px-2 py-1 text-sm text-gray-600 hover:underline" href="/">Cancel</a>{{/if}}
    </form>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead><tr class="font-bold">
          <th class="py-1">ProductName</th><th class="py-1">Description</th><th class="py-1">Category</th><th class="py-1">Price</th><th class="py-1">Quantity</th><th class="py-1">Action</th>
        </tr></thead>
        <tbody>
          {{#each products}}
            <tr>
              <td class="py-1">{{this.productname}}</td><td class="py-1">{{this.description}}</td><td class="py-1">{{this.category}}</td><td class="py-1">{{this.price}}</td><td class="py-1">{{this.quantity}}</td>
              <td class="py-1"><a class="mr-3 text-blue-700 hover:underline" href="/?edit={{this.id}}">edit</a><form class="inline" action="/products/{{this.id}}/delete" method="POST" onsubmit="return confirm('Delete this product?')"><button class="text-blue-700 hover:underline" type="submit">delete</button></form></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless products.length}}<p class="py-3 text-sm text-gray-500">No products yet.</p>{{/unless}}
    </div>
  </main>
{{> footer }}
